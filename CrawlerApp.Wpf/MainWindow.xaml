<Window x:Class="CrawlerApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrawlerApp.Wpf"
        mc:Ignorable="d"
        Title="CrawlerApp" Height="720" Width="1100">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
            <TextBox Width="480" Margin="0,0,12,0" Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Start" Width="120" Margin="0,0,8,0" Command="{Binding StartCommand}" />
            <Button Content="Stop" Width="120" Command="{Binding StopCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" >
            <TextBlock Text="Queued:" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatsQueued}" Margin="4,0,16,0" />
            <TextBlock Text="Fetched:" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatsFetched}" Margin="4,0,16,0" />
            <TextBlock Text="Parsed:" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatsParsed}" Margin="4,0,16,0" />
            <TextBlock Text="Errors:" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatsErrors}" Margin="4,0,16,0" />
            <TextBlock Text="Assets:" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatsAssets}" Margin="4,0,16,0" />
            <TextBlock Text="Pages/min:" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatsPagesPerMinute}" Margin="4,0,16,0" />
        </StackPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="Pages">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGrid ItemsSource="{Binding Pages}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="80" />
                            <DataGridTextColumn Header="Title" Binding="{Binding TitleSnippet}" Width="300" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Assets">
                <DataGrid ItemsSource="{Binding Assets}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Page URL" Binding="{Binding Url}" Width="*" />
                        <DataGridTextColumn Header="Asset" Binding="{Binding AssetUrl}" Width="400" />
                        <DataGridTextColumn Header="Type" Binding="{Binding AssetType}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Logs">
                <ListBox ItemsSource="{Binding Logs}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
